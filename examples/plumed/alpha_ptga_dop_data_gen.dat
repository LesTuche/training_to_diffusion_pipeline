UNITS LENGTH=A ENERGY=eV TIME=fs
c1: COORDINATION GROUPA=@Pt@ GROUPB=@Ga@ R_0=3.4 NN=12 MM=24
c2: COORDINATION GROUPA=@Pt@ GROUPB=@Pt@ R_0=3.5 NN=12 MM=24
c3: COORDINATION GROUPA=@Ga@ GROUPB=@Ga@ R_0=3.2 NN=12 MM=24
c4: COORDINATION GROUPA=@Pt@ GROUPB=@C@ R_0=2.7 NN=12 MM=24
c5: COORDINATION GROUPA=@Ga@ GROUPB=@C@ R_0=2.5 NN=12 MM=24
c6: COORDINATION GROUPA=@C@ GROUPB=@C@ R_0=1.9 NN=12 MM=24
alpha_ptga: MATHEVAL ARG=c1,c2,c3 VAR=c1,c2,c3 FUNC=1-2*(c1/(c1+c2+c3)) PERIODIC=NO
alpha_ptc: MATHEVAL ARG=c4,c2,c6 VAR=c4,c2,c6 FUNC=1-2*(c4/(c2+c4+c6)) PERIODIC=NO
alpha_gac: MATHEVAL ARG=c5,c3,c6 VAR=c5,c3,c6 FUNC=1-2*(c5/(c3+c5+c6)) PERIODIC=NO
alpha_dop: MATHEVAL ARG=alpha_ptc,alpha_gac VAR=alpha_ptc,alpha_gac FUNC=0.5*(alpha_gac+alpha_ptc) PERIODIC=NO
opes: OPES_METAD ARG=alpha_ptga,alpha_dop PACE=100 BARRIER=3 TEMP=873 STATE_WSTRIDE=10000 NLIST STATE_WFILE=STATE
PRINT ARG=alpha_ptga,c1,c2,c3,c4,c5,alpha_ptc,alpha_gac,alpha_dop,opes.* FILE=COLVAR STRIDE=10
FLUSH STRIDE=10
