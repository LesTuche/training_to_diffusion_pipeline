UNITS LENGTH=A ENERGY=eV TIME=fs
c1: COORDINATION GROUPA=@Pt@ GROUPB=@Ga@ R_0=3.4 NN=12 MM=24
c2: COORDINATION GROUPA=@Pt@ GROUPB=@Pt@ R_0=3.5 NN=12 MM=24
c3: COORDINATION GROUPA=@Ga@ GROUPB=@Ga@ R_0=3.2 NN=12 MM=24
alpha_ptga: MATHEVAL ARG=c1,c2,c3 VAR=c1,c2,c3 FUNC=1-2*(c1/(c1+c2+c3)) PERIODIC=NO
opes: OPES_METAD ARG=alpha_ptga PACE=750 BARRIER=3 TEMP=873 STATE_WSTRIDE=50000 NLIST STORE_STATES STATE_WFILE=STATE
PRINT ARG=alpha_ptga,c1,c2,opes.* FILE=COLVAR STRIDE=10
FLUSH STRIDE=10
